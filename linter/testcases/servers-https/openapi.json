{
    "openapi": "3.0.3",
    "info": {
        "title": "Servers HTTPS",
        "description": "Deze OpenAPI specification bevat servers zonder https op hoofd-, pad-, operatie- en callbackniveau, en een schema met een property genaamd servers die niet gevalideerd mag worden.",
        "contact": {
            "name": "Beheerder",
